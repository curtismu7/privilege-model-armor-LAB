# Optional. Everything has a safe default; the lab needs no tenant and no credentials.
# PORT must be in 7800-7999 (7846 is PROVISIONAL, not claimed on the board yet).
PORT=7846
# PMA_BIND=127.0.0.1   # loopback only unless you set this on purpose (the Docker image sets it inside the container)
# LAB_ALLOWED_HOSTS=   # extra host names that reach this Mac; docker compose defaults to the lab-proxy names (local.ping-devops.com and privilege-model-armor-lab.local.ping-devops.com); loopback always works
# CUSTOMER_CONFIG=     # path to a customer.config.json (branding and vocabulary)
