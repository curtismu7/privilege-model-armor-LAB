#!/bin/sh
# Refuse a commit that stages a secret. Installed by `npm install` (core.hooksPath).
if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks protect --staged --redact
fi
echo "pre-commit: gitleaks not installed (brew install gitleaks); CI scans every push, but install it so a secret is caught before it leaves your machine." >&2
